# Node.js 24.12+; template only. Do not commit a populated .env.
RITM_BASE_URL=https://ritm-erp.zinovevkirill234.chatgpt.site
RITM_AGENT_PORT=4318
RITM_CHECK_INTERVAL_SECONDS=600
RITM_REQUEST_TIMEOUT_SECONDS=25
RITM_REQUEST_RETRIES=2
RITM_SNAPSHOT_MAX_AGE_SECONDS=1200
RITM_SLOW_API_MS=5000
# Manual CLI only, >=32 chars; Windows setup uses DPAPI.
RITM_OWNER_TOKEN=
# Default: %LOCALAPPDATA%/RITMIntelligence, outside Git.
RITM_DATA_DIR=
RITM_SOURCE_REGISTRY=
# Only if developing using Vite on this origin.
RITM_DEV_ORIGIN=http://127.0.0.1:5173
RITM_TELEGRAM_ENABLED=false
RITM_TELEGRAM_BOT_TOKEN=
RITM_TELEGRAM_OWNER_CHAT_ID=
# Stage 3 only; no LLM calls in stage 1.
RITM_AI_MODEL=

# Table Doctor stage 2, agent only. Credential JSON must be outside repository.
RITM_GOOGLE_CREDENTIALS_FILE=
RITM_DOCTOR_REGISTRY=
# Explicit opt-in for labelled local fixture; false for regular monitoring.
RITM_DOCTOR_DEMO_ENABLED=false
