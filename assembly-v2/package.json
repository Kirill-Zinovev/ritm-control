{
  "name": "assembly-web-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/local.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "verify:legacy": "node scripts/verify-legacy.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jsbarcode": "3.12.3",
    "lucide-react": "0.525.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/jsbarcode": "3.11.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
